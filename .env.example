# Environment variables for Rebex Tele App

# TELEX_PUBLIC_SUPABASE_URL: The URL of your Supabase project. This is used to connect to your Supabase database and services.
# TELEX_PUBLIC_SUPABASE_ANON_KEY: The anonymous key for your Supabase project. This key is used for public access to your Supabase services.
# TELEX_SERVICE_ROLE_KEY: The service role key for your Supabase project. This key is used for server-side operations and should be kept secret.
# TELEX_CRON_SECRET: A secret key used for securing cron jobs or scheduled tasks in your application. This should be kept secret and not exposed publicly.
# TELEX_ENCRYPTION_KEY: A key used for encrypting sensitive data in your application. This key should be kept secret and not exposed publicly.

TELEX_PUBLIC_SUPABASE_URL=<your-supabase-url>
TELEX_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
TELEX_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
TELEX_CRON_SECRET=<your-cron-secret>
TELEX_ENCRYPTION_KEY=<your-encryption-key>